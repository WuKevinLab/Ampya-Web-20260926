# 对外访问地址（生成主页链接、付款链接、邮件里的链接都用它）
PUBLIC_URL=http://localhost:3000
PORT=3000
# 数据目录：SQLite 数据库、代理工作区文件、商品文件
DATA_DIR=./data

# AI 代理与 AI 分身（不填则代理离线，分身用 FAQ 匹配兜底）
ANTHROPIC_API_KEY=
# 可选，默认 claude-opus-5-5
ANTHROPIC_MODEL=

# Stripe 收款（不填则为测试模式：结账直接记为已付，不扣卡）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro 订阅的 Price ID（$29/月）
STRIPE_PRO_PRICE_ID=

# 发信（审批通过的代理邮件、买家收据）。不填则只记录不发送
RESEND_API_KEY=
MAIL_FROM=Creator Crew <crew@yourdomain.com>

# 管理员邮箱（逗号分隔）；不填时第一个注册的账号是管理员
ADMIN_EMAILS=
# 部署在反向代理后面时设为 1，按 X-Forwarded-For 限流
TRUST_PROXY=

# 可选：启动时创建一个带示例数据（Ava Lee）的演示账号
DEMO_EMAIL=
DEMO_PASSWORD=
